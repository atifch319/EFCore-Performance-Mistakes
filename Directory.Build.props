<Project>
  <!--
    Microsoft.Data.SqlClient currently pulls System.Security.Cryptography.Pkcs 9.0.11,
    which NuGet audit reports as vulnerable. Referencing the patched package directly
    overrides that transitive dependency.
  -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
</Project>
